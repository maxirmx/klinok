{
  "name": "klinok",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "workspaces": [
    "api-node",
    "packages/contracts"
  ],
  "scripts": {
    "release:bump": "node scripts/bump-version.mjs",
    "build:contracts": "npm run build --workspace @klinok/contracts",
    "build:api": "npm run build --workspace @klinok/api-node",
    "api:node": "npm run start --workspace @klinok/api-node",
    "api:provision": "npm run provision --workspace @klinok/api-node",
    "predev": "npm run build:contracts",
    "dev": "vite --host 127.0.0.1",
    "build:ui": "npm run build:contracts && vue-tsc --noEmit && vite build",
    "build": "npm run build:ui && npm run build:api",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run build:contracts",
    "test": "vitest run --run && npm test --workspace @klinok/api-node",
    "lint": "eslint . --ext .vue,.ts,.js,.jsx,.cjs,.mjs --fix",
    "lint:check": "eslint . --ext .vue,.ts,.js,.jsx,.cjs,.mjs",
    "precoverage": "npm run build:contracts",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:compose": "sh scripts/compose-smoke.sh"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.8",
    "@klinok/contracts": "*",
    "pinia": "^4.0.2",
    "vue": "^3.5.16",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "glob": "^13.0.6",
    "minimatch": "^10.2.6"
  },
  "allowScripts": {
    "classic-level@3.0.0": true,
    "esbuild@0.28.1": true,
    "argon2@0.44.0": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.55.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
